{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m4-benchmark-terminal.v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "origin",
    "started_at",
    "closed_at",
    "status",
    "failure_code",
    "active_arm",
    "completed_arms",
    "model_calls_started",
    "automatic_promotion",
    "retry_allowed",
    "observed_runtime",
    "capability_fingerprint",
    "frozen_hashes",
    "artifacts_retained_private"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "run_id": {"type": "string", "pattern": "^br1-[0-9a-f]{16}$"},
    "origin": {"const": "unsigned-local-audit"},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "closed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "status": {"enum": ["interrupted", "timed-out", "failed"]},
    "failure_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "active_arm": {"enum": [null, "all-max-control", "dynamic-v0.2.1"]},
    "completed_arms": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["all-max-control", "dynamic-v0.2.1"]}
    },
    "model_calls_started": {"type": "integer", "minimum": 0, "maximum": 2},
    "automatic_promotion": {"const": false},
    "retry_allowed": {"const": false},
    "observed_runtime": {
      "type": "object",
      "required": ["codex_version", "executable_sha256"],
      "properties": {
        "codex_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "executable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "capability_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"},
    "frozen_hashes": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "benchmark_config_sha256",
          "pilot_plan_sha256",
          "fixture_manifest_sha256",
          "prompt_sha256",
          "oracle_sha256"
        ]
      },
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "artifacts_retained_private": {"const": true}
  },
  "additionalProperties": false
}
